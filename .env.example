# # Loaded automatically by `npm run dev` when NODE_ENV is not set.
# # Keep your real .env.development private; it is ignored by Git.
# # OPENROUTER_MODEL=openrouter/free

# # Optional OpenRouter attribution headers

# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# OpenRouter / OpenAI-compatible provider
#API gunwp2@gmail.com Limit 27/07
# API gunwp.palubasa@gmail.com
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_BASE_URL=
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=4096
AI_MAX_RETRIES=1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# PostgreSQL / Neon: keep the full URI on one line and include sslmode=require.
# Never commit the real URI or password.
DATABASE_URL=
PGPOOL_MAX=
PG_IDLE_TIMEOUT_MS=
PG_CONNECTION_TIMEOUT_MS=
