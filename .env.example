# # Server
# # Comma-separated origins. Leave empty to allow all origins during development.
# # All localhost/127.0.0.1 ports are accepted automatically in development.

# # Local PostgreSQL Configuration (Default Fallback if DATABASE_URL is commented):
# # PGHOST=localhost
# # PGPORT=5432
# # PGDATABASE=agent_marketing
# # PGUSER=postgres
# # PGPASSWORD=postgres

# #postGreQL Production Configuration (Default Fallback if DATABASE_URL is commented):
