# Loaded automatically by `npm run dev` when NODE_ENV is not set.
# Keep your real .env.development private; it is ignored by Git.
OPENROUTER_API_KEY=replace_with_a_new_openrouter_key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# OPENAI_MODEL is used only for the direct OpenAI provider or as a fallback.
# OPENAI_MODEL=openai/gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=4096
# All localhost/127.0.0.1 ports are accepted automatically in development.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Marketing AI Agent Development

# PostgreSQL persistence (local development)
PGHOST=localhost
PGPORT=5432
PGDATABASE=stela_ledger
PGUSER=postgres
PGPASSWORD=replace_with_local_postgres_password
