# Server
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://your-frontend-domain.example

# OpenRouter / OpenAI-compatible provider
OPENROUTER_API_KEY=replace_with_production_key
OPENROUTER_MODEL=your-production-model
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=4096
AI_MAX_RETRIES=1
OPENROUTER_SITE_URL=https://api.your-domain.example
OPENROUTER_APP_NAME=Marketing AI Agent

# PostgreSQL / Neon: keep the full URI on one line and include sslmode=require.
# Never commit the real URI or password.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
PGPOOL_MAX=5
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
